# AIX local development environment
# Copy this file to .env and fill in the local PostgreSQL connection string.
# Never commit .env or put secrets in this file.

# Required by @workspace/db
DATABASE_URL=

# Optional local API settings (defaults shown in the documentation)
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Optional local frontend settings
BASE_PATH=/
API_PORT=8080